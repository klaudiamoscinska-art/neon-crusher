+/**
+ * Optional raster sprites (NC-ART-ASSETS-1). Loads each file once with
+ * `new Image()` (same origin, relative path); `draw` returns false while a
+ * sprite is unavailable so the caller draws its procedural version. Each
+ * sprite is resampled once per device-pixel size (halving steps keep thin
+ * neon lines sharp at 20-60 px) and cached, so a frame costs one drawImage
+ * per sprite and no per-frame resampling of the 256 px source. Without
+ * `Image` (QA harness) nothing loads and everything stays procedural.
+ * Drawing only: nothing here feeds the simulation (NC-03).
+ */
+class SpriteSheet {
+  constructor(files, dir) {
+    this.entries = new Map();
+    this.cache = new Map();
+    // Device pixels per world unit (dpr x viewScale), set by Game.resize.
+    this.scale = 1;
+    if (typeof Image !== 'function') return;
+    for (const name of Object.keys(files)) {
+      const img = new Image();
+      const entry = { img, ready: false, failed: false };
+      img.onload = () => { entry.ready = img.naturalWidth > 0 && img.naturalHeight > 0; };
+      img.onerror = () => { entry.failed = true; };
+      img.src = dir + files[name];
+      this.entries.set(name, entry);
+    }
+  }
+
+  ready(name) {
+    const e = this.entries.get(name);
+    return !!(e && e.ready);
+  }
+
+  /** The sprite resampled to `px` device pixels (bucketed to 4 px, never
+   *  above the source), or the source image itself if no canvas is
+   *  available; null while the sprite is unavailable. */
+  scaled(name, px) {
+    const e = this.entries.get(name);
+    if (!e || !e.ready) return null;
+    const full = e.img.naturalWidth;
+    const size = clamp(Math.ceil(px / 4) * 4, 8, full);
+    if (size >= full) return e.img;
+    const key = `${name}@${size}`;
+    const hit = this.cache.get(key);
+    if (hit) {
+      this.cache.delete(key);
+      this.cache.set(key, hit);
+      return hit;
+    }
+    let out = e.img;
+    try {
+      let src = e.img;
+      let w = full;
+      while (w / 2 >= size) {
+        w = Math.round(w / 2);
+        const step = document.createElement('canvas');
+        step.width = w;
+        step.height = w;
+        const g = step.getContext('2d');
+        g.imageSmoothingQuality = 'high';
+        g.drawImage(src, 0, 0, w, w);
+        src = step;
+      }
+      if (w !== size) {
+        const last = document.createElement('canvas');
+        last.width = size;
+        last.height = size;
+        const g = last.getContext('2d');
+        g.imageSmoothingQuality = 'high';
+        g.drawImage(src, 0, 0, size, size);
+        src = last;
+      }
+      out = src;
+    } catch (err) {
+      out = e.img;
+    }
+    this.cache.set(key, out);
+    if (this.cache.size > SPRITE_CACHE_MAX) this.cache.delete(this.cache.keys().next().value);
+    return out;
+  }
+
+  /** Draws sprite `name` centred on (cx, cy), `size` world units square,
+   *  rotated by `rotation`. `px` (optional) fixes the cached resolution for
+   *  sprites whose size animates. Returns false if it drew nothing. */
+  draw(ctx, name, cx, cy, size, rotation = 0, px = 0) {
+    const img = this.scaled(name, px || size * this.scale);
+    if (!img) return false;
+    if (rotation) {
+      ctx.save();
+      ctx.translate(cx, cy);
+      ctx.rotate(rotation);
+      ctx.drawImage(img, -size / 2, -size / 2, size, size);
+      ctx.restore();
+    } else {
+      ctx.drawImage(img, cx - size / 2, cy - size / 2, size, size);
+    }
+    return true;
+  }
+}
